        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VaultBox benötigt Zugriff auf Fotos, um die Originale zu löschen. Erlauben Sie Zugriff auf Fotos in den Einstellungen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
