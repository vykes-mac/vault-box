    "Backups are encrypted before they leave your phone, so the cloud only ever holds noise." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups werden noch auf Ihrem Handy verschlüsselt. In der Cloud landen nur unlesbare Daten."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los respaldos se cifran antes de salir de tu teléfono. La nube solo recibe datos ilegibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont chiffrées avant de quitter votre téléphone. Le cloud ne reçoit que des données illisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup vengono crittografati prima di lasciare il telefono. Sul cloud arrivano solo dati illeggibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは端末内で暗号化されるため、クラウドに保存されるのは読み取れないデータだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 휴대폰을 떠나기 전에 암호화되어 클라우드에는 읽을 수 없는 데이터만 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups são criptografados antes de sair do celular. A nuvem recebe apenas dados ilegíveis."
          }
        }
      }
    },
