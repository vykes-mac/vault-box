    "Nothing opens without your PIN or your face — not even the app switcher preview." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Ihre PIN oder Face ID wird nichts angezeigt – nicht einmal in der App-Umschalter-Vorschau."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se abre sin tu PIN o Face ID, ni siquiera la vista previa del selector de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne s’ouvre sans votre code PIN ou Face ID, pas même l’aperçu du sélecteur d’apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla si apre senza il tuo PIN o Face ID, nemmeno l’anteprima nel selettore app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINまたはFace IDなしでは開けません。アプリスイッチャーのプレビューにも表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN 또는 Face ID 없이는 열리지 않으며 앱 전환 화면 미리보기에도 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada abre sem seu PIN ou Face ID, nem mesmo a prévia do Seletor de Apps."
          }
        }
      }
    },
    "Nothing reaches a server. No sign-up, no email, no profile." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
