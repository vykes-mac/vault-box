    "%@ %@. Auto-renews unless cancelled 24 hours before the period ends. Manage in Apple Account settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@. Automatische Verlängerung, sofern Sie nicht mindestens 24 Stunden vor Ablauf kündigen. Verwaltung in den Apple-Account-Einstellungen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@. Se renueva automáticamente, a menos que canceles al menos 24 horas antes de que termine el periodo. Administra la suscripción en la configuración de tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@. Renouvellement automatique sauf résiliation au moins 24 heures avant la fin de la période. Gérez l’abonnement dans les réglages de votre compte Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@. Rinnovo automatico salvo annullamento almeno 24 ore prima della fine del periodo. Gestisci l’abbonamento nelle impostazioni dell’account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）。期間終了の24時間前までにキャンセルしない限り、自動更新されます。Apple Accountの設定で管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. 기간 종료 24시간 전까지 해지하지 않으면 자동으로 갱신됩니다. Apple 계정 설정에서 관리할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@. A renovação é automática, a menos que você cancele pelo menos 24 horas antes do fim do período. Gerencie a assinatura nos ajustes da sua Conta Apple."
          }
        }
      }
    },
