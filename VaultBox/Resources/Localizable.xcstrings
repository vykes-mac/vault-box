    "All data is encrypted before uploading to your private iCloud storage. Apple cannot read your files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Daten werden verschlüsselt, bevor sie auf Ihren privaten iCloud-Speicher hochgeladen werden. Apple kann Ihre Dateien nicht lesen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los datos se cifran antes de subirlos a tu espacio privado de iCloud. Apple no puede leer tus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les données sont chiffrées avant leur envoi vers votre espace iCloud privé. Apple ne peut pas lire vos fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i dati sono crittografati prima di essere caricati nel tuo archivio privato iCloud. Apple non può leggere i tuoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはすべて暗号化されてから個人のiCloudストレージにアップロードされます。Appleがファイルの内容を読み取ることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 데이터는 개인 iCloud 저장 공간에 업로드되기 전에 암호화됩니다. Apple은 파일 내용을 읽을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dados são criptografados antes de serem carregados para o seu armazenamento privado iCloud. A Apple não pode ler seus arquivos."
          }
        }
      }
    },
