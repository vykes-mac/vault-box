      }
    },
    "You're charged %@ unless you cancel before then." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie nicht vorher kündigen, werden %@ berechnet."
