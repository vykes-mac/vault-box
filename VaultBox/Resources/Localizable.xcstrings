        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Angabe bleibt auf Ihrem Handy. Niemand sonst sieht Ihre Antwort."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
