    "A disguise opens as a small utility. iOS keeps the Home Screen label “VaultBox”; only a user-created Shortcut can use a different label." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Disguise öffnet sich als kleines Dienstprogramm. iOS behält das Etikett des Startbildschirms \"VaultBox\"; nur ein von dem Benutzer erstellter Schnellzugriff kann ein anderes Etikett verwenden."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disfraz se abre como una pequeña utilidad. iOS conserva el nombre «VaultBox» en la pantalla de inicio; solo un Atajo creado por el usuario puede mostrar otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un déguisement s'ouvre sous forme d'un petit utilitaire. iOS conserve l'étiquette de l'écran d'accueil \"VaultBox\" ; seuls les raccourcis créés par l'utilisateur peuvent utiliser une étiquette différente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il travestimento si apre come una piccola utility. iOS mantiene il nome «VaultBox» nella schermata Home; solo un Comando Rapido creato dall’utente può mostrare un nome diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偽装は小さなユーティリティとして開きます。iOSはホーム画面のラベル「VaultBox」を維持します。ユーザー作成のショートカットのみが異なるラベルを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가면은 작은 유틸리티로 열립니다. iOS는 홈 화면 레이블을 \"VaultBox\"로 유지합니다. 사용자 생성된 바로가기만 다른 레이블을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um disfarce abre como um pequeno utilitário. iOS mantém a etiqueta da Tela de Início \"VaultBox\"; apenas um Atalho criado pelo usuário pode usar uma etiqueta diferente."
          }
        }
      }
    },
    "A document in your vault expires today. Tap to review." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Dokument im Tresor läuft heute ab. Tippen Sie, um es zu prüfen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un documento en tu bóveda expira hoy. Toca para revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un document de votre coffre expire aujourd’hui. Touchez pour le vérifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un documento nella cassaforte scade oggi. Tocca per controllarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫内の書類が今日期限切れになります。タップして確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함의 문서가 오늘 만료됩니다. 탭하여 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um documento em seu cofre expira hoje. Toque para revisar."
          }
        }
      }
    },
