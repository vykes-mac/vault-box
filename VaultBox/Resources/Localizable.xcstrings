    "You can use this one-time code to reset your PIN if you forget it. It won't be shown again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem einmaligen Code können Sie Ihre PIN zurücksetzen, falls Sie sie vergessen. Der Code wird nicht erneut angezeigt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se te olvida tu código PIN, puedes usar este código único para restablecerlo. No se mostrará de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser ce code unique pour réinitialiser votre PIN si vous vous en souvenez pas. Il ne sera pas affiché à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi utilizzare questo codice univoco per reimpostare il tuo PIN se lo dimentichi. Non verrà mostrato più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この一回限りのコードは、PINを忘れた場合にリセットするために使用できます。 もう表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN을 잊은 경우 이 일회용 코드로 재설정할 수 있습니다. 코드는 다시 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode usar este código único para redefinir seu PIN se você se esquecer dele. Ele não será mostrado novamente."
          }
        }
      }
    },
    "You hand your phone to a kid and open Photos by muscle memory." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie geben einem Kind Ihr Handy und öffnen aus Gewohnheit die Fotos-App."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prestas tu teléfono a un niño y, por costumbre, abres Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous prêtez votre téléphone à un enfant et, par réflexe, ouvrez Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai il telefono a un bambino e, per abitudine, apri Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子どもにスマホを渡すとき、つい写真アプリを開いてしまう。"
          }
        },
        "ko" : {
          "stringUnit" : {
