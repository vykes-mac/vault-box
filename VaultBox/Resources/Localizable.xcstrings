    "Files are decrypted for download and encrypted on upload. The server is only accessible on your local network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien werden für den Download entschlüsselt und beim Upload verschlüsselt. Der Server ist nur in Ihrem lokalen Netzwerk erreichbar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos se descifran al descargarlos y se cifran al subirlos. Solo se puede acceder al servidor desde tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers sont déchiffrés lors du téléchargement et chiffrés lors de l’envoi. Le serveur est accessible uniquement sur votre réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file vengono decrittati per il download e crittografati durante l'upload. Il server è accessibile solo sulla tua rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはダウンロード時に暗号化され、アップロード時に暗号化されます。サーバーはローカルネットワークのみにアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일은 다운로드 시 해독되고 업로드 시 암호화됩니다. 서버는 로컬 네트워크에서만 액세스할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos são descriptografados para download e criptografados no upload. O servidor só é acessível na sua rede local."
          }
        }
      }
    },
