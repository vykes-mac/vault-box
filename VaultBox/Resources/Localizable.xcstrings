    "\"I stopped panicking every time someone asked to see a photo on my phone.\"" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich gerate nicht mehr jedes Mal in Panik, wenn jemand ein Foto auf meinem Handy sehen will.“"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Dejé de entrar en pánico cada vez que alguien me pedía ver una foto en mi teléfono”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Je ne panique plus chaque fois que quelqu’un me demande de voir une photo sur mon téléphone. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ho smesso di andare nel panico ogni volta che qualcuno mi chiede di vedere una foto sul mio telefono.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スマホの写真を見せてと言われても、もう焦らなくなりました。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“누가 휴대폰 사진을 보여 달라고 해도 더 이상 불안하지 않아요.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Parei de entrar em pânico toda vez que alguém pedia para ver uma foto no meu celular.”"
          }
        }
      }
    },
    "\"Let me see that photo\" — and they keep scrolling." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zeig mir mal das Foto“ – und schon wird weitergewischt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Déjame ver esa foto”… y siguen deslizando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Montre-moi cette photo »… puis la personne continue de faire défiler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Fammi vedere quella foto»… e continuano a scorrere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「その写真見せて」から、そのまま次々と見られてしまう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“그 사진 좀 보여 줘”라고 한 뒤 계속 넘겨봅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Deixa eu ver essa foto”… e a pessoa continua rolando."
          }
        }
      }
    },
    "\"The break-in photo caught my brother going through my phone. Worth it alone.\"" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Das Einbruchfoto hat meinen Bruder dabei erwischt, wie er mein Handy durchsucht hat. Allein dafür hat es sich gelohnt.“"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“La foto de intrusión captó a mi hermano revisando mi teléfono. Solo por eso valió la pena”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« La photo d’intrusion a surpris mon frère en train de fouiller mon téléphone. Rien que pour ça, ça valait le coup. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La foto anti-intrusione ha sorpreso mio fratello mentre frugava nel mio telefono. È valsa la pena anche solo per questo.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「侵入者撮影で、兄がスマホを勝手に見ていたことが分かりました。それだけでも使う価値がありました。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“침입자 사진 덕분에 동생이 내 휴대폰을 뒤지는 걸 잡았어요. 이것만으로도 충분히 가치 있었어요.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A foto de invasão pegou meu irmão mexendo no meu celular. Só isso já valeu a pena.”"
          }
        }
      }
    },
