            "value" : "Se te cobrará %@, a menos que canceles antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez facturé %@, sauf résiliation avant cette date."
          }
        },
        "it" : {
          "stringUnit" : {
