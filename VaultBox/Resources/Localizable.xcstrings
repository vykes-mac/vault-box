          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS te pedirá confirmar el nuevo icono. Esa alerta es de Apple, no nuestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vous demandera de confirmer la nouvelle icône. Cette alerte vient d’Apple, pas de nous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ti chiederà di confermare la nuova icona. Quell’avviso è di Apple, non nostro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSが新しいアイコンの確認を求めます。この確認はAppleによるもので、当アプリのものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 새 아이콘 확인을 요청합니다. 그 알림은 Apple의 것이며 저희 것이 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS vai pedir para confirmar o novo ícone. Esse alerta é da Apple, não nosso."
          }
        }
      }
    },
    "It already happened once. Let's make sure it can't happen again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist schon einmal passiert. Sorgen wir dafür, dass es nicht wieder vorkommt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya pasó una vez. Evitemos que vuelva a suceder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est déjà arrivé. Faisons en sorte que cela ne se reproduise pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già successo. Facciamo in modo che non accada di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度起きたことを、二度と起こさないために。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 한 번 일어났다면, 다시는 일어나지 않게 하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já aconteceu uma vez. Vamos impedir que aconteça de novo."
          }
        }
      }
    },
    "It's never the stranger. It's the person next to you." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist selten ein Fremder. Meist ist es jemand in Ihrer Nähe."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi nunca es un extraño. Es alguien cercano a ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est presque jamais un inconnu, mais quelqu’un de votre entourage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi mai è uno sconosciuto. È qualcuno vicino a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見知らぬ人より、身近な人かもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낯선 사람이 아니라 가까이에 있는 사람일 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase nunca é um estranho. É alguém próximo de você."
          }
        }
      }
    },
