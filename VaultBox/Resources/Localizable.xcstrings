    "Find information across your documents, photos, and screenshots. VaultBox searches the text in all your files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finden Sie Informationen in Ihren Dokumenten, Fotos und Screenshots. VaultBox durchsucht den Text in allen Ihren Dateien."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra información en todos tus documentos, fotos y capturas de pantalla. VaultBox busca el texto en todos tus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez des informations dans vos documents, photos et captures d'écran. VaultBox recherche le texte dans tous vos fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova informazioni tra i tuoi documenti, foto e screenshot. VaultBox cerca nel testo di tutti i tuoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメント、写真、スクリーンショット全体で情報を検索します。VaultBoxは、すべてのファイルのテキストを検索します。"
          }
        },
        "ko" : {
