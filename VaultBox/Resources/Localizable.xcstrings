          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料アイテムの制限に達しました。無制限のストレージを体験するには、プレミアムにアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 아이템 제한을 초과했습니다. 무제한 저장 공간을 위해 프리미엄으로 업그레이드하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você atingiu o limite de itens gratuitos. Atualize para Premium para armazenamento ilimitado."
          }
        }
      }
    },
    "You've reached your free limit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenloses Limit erreicht"
          }
        },
