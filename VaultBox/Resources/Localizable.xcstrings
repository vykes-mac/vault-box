    "A second PIN opens a harmless-looking vault, so being asked to unlock costs you nothing." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zweite PIN öffnet einen harmlos wirkenden Täusch-Tresor. So bleiben Ihre echten Daten verborgen, selbst wenn Sie zum Entsperren aufgefordert werden."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un segundo PIN abre una bóveda señuelo que parece inofensiva, para que tus datos reales sigan ocultos aunque te pidan desbloquear la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un second code PIN ouvre un coffre leurre anodin. Vos vraies données restent ainsi masquées, même si l’on vous demande de déverrouiller l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un secondo PIN apre una cassaforte esca dall’aspetto innocuo, così i tuoi dati reali restano nascosti anche se ti chiedono di sbloccare l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つ目のPINで無害に見えるおとり保管庫を開けます。ロック解除を求められても、本物のデータは見せずに済みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번째 PIN으로 평범해 보이는 위장 보관함을 열 수 있어요. 잠금을 풀어 달라는 요구를 받아도 실제 데이터는 숨겨집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um segundo PIN abre um cofre de disfarce com aparência inofensiva. Assim, seus dados reais continuam ocultos mesmo se pedirem para desbloquear o app."
          }
        }
      }
    },
    "A silent photo of anyone who guesses your PIN wrong, with the time it happened." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt unbemerkt ein Foto von jeder Person auf, die eine falsche PIN eingibt – einschließlich Uhrzeit."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma discretamente una foto de quien ingrese mal tu PIN, junto con la hora del intento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prend discrètement en photo toute personne qui saisit un mauvais code PIN, avec l’heure de la tentative."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta in silenzio una foto di chi inserisce un PIN errato, insieme all’ora del tentativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINを間違えた人を、日時とともに気付かれずに撮影します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN을 잘못 입력한 사람을 시각 정보와 함께 몰래 촬영합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira discretamente uma foto de quem errar seu PIN, junto com o horário da tentativa."
          }
        }
      }
    },
