    "Anyone holding your phone is one swipe from everything." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer Ihr Handy in der Hand hält, ist nur einen Wisch von allem entfernt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga tu teléfono está a un solo deslizamiento de verlo todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque tient votre téléphone n’est qu’à un geste de tout voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia in mano il tuo telefono è a un solo gesto dal vedere tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマホを手にした人は、ひとスワイプですべてを見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰을 손에 든 사람은 한 번만 넘기면 모든 것을 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem estiver com seu celular está a um deslize de ver tudo."
          }
        }
      }
    },
    "Anyone scrolling your Home Screen sees a small utility app. Opening it shows a working one — your vault is behind a private gesture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer über Ihren Home-Bildschirm wischt, sieht eine kleine Hilfs-App. Beim Öffnen erscheint eine funktionierende App – Ihr Tresor liegt hinter einer geheimen Geste."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien recorra tu pantalla de inicio verá una pequeña app de utilidades. Al abrirla, funciona de verdad: tu bóveda está detrás de un gesto privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque parcourt votre écran d’accueil voit un petit utilitaire. En l’ouvrant, il fonctionne vraiment — votre coffre est caché derrière un geste secret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi scorre la tua schermata Home vede una piccola app di utilità. Aprendola ne trova una funzionante: la cassaforte è dietro un gesto privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面をスクロールした人には、小さなユーティリティアプリに見えます。開いても本物として動作し、保管庫は秘密のジェスチャーの先にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면을 넘겨보는 사람에게는 작은 유틸리티 앱으로 보입니다. 열어도 실제로 작동하며, 보관함은 비밀 제스처 뒤에 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem passar pela sua Tela de Início vê um pequeno app utilitário. Ao abrir, ele funciona de verdade — seu cofre fica atrás de um gesto secreto."
          }
        }
      }
    },
    "App Icon" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
